NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TURN Server (needed for internet/cross-network transfers)
# Get free credentials at https://www.metered.ca/tools/openrelay/
NEXT_PUBLIC_TURN_URLS=turn:relay.metered.ca:80,turn:relay.metered.ca:443,turn:relay.metered.ca:443?transport=tcp,turns:relay.metered.ca:443
NEXT_PUBLIC_TURN_USERNAME=YOUR_METERED_USERNAME
NEXT_PUBLIC_TURN_CREDENTIAL=YOUR_METERED_CREDENTIAL
